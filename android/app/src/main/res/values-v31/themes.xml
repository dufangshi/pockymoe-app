<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RemoteCodex" parent="Base.Theme.RemoteCodex">
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowSplashScreenBackground">#FAFAF8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <!-- Stable persisted starting-window themes; neither changes the Activity theme. -->
    <style name="Theme.RemoteCodex.StartupDark" parent="Base.Theme.RemoteCodex">
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">#17171A</item>
        <item name="android:windowSplashScreenBackground">#17171A</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.RemoteCodex.StartupLight" parent="Base.Theme.RemoteCodex">
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">#FAFAF8</item>
        <item name="android:windowSplashScreenBackground">#FAFAF8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
