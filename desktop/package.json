{
  "name": "@pockymoe/desktop",
  "version": "0.3.2",
  "private": true,
  "description": "Pockymoe desktop client",
  "author": "Pockymoe",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --project=electron",
    "dist:mac": "pnpm build && electron-builder --mac dmg --arm64 --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "sherpa-onnx-node": "2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "electron": "45.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin",
        "win32"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    },
    "overrides": {
      "sherpa-onnx-node>sherpa-onnx-darwin-x64": "-",
      "sherpa-onnx-node>sherpa-onnx-win-arm64": "-"
    }
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "2.0.1",
    "sherpa-onnx-win-x64": "2.0.1"
  }
}
